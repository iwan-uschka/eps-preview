%!PS-Adobe-3.0 EPSF-3.0
%%BoundingBox: 0 0 64 64
%%Title: Minimal EPS whose image dictionary asks for interpolation
%%Creator: eps-preview test fixtures
%%LanguageLevel: 2
%%Pages: 1
%%EndComments
%%Page: 1 1
gsave
/DeviceGray setcolorspace
0 0 translate
64 64 scale
<<
  /ImageType 1
  /Width 2
  /Height 2
  /BitsPerComponent 8
  /Decode [0 1]
  /ImageMatrix [2 0 0 -2 0 2]
  /DataSource <00FFFF00>
  /Interpolate true
>> image
grestore
showpage
%%EOF
